# LLM provider: "ollama" (default, no API key) or "claude" (requires ANTHROPIC_API_KEY)
LLM_PROVIDER=ollama

# Ollama model to use (must be pulled first: `ollama pull llama3.2`)
OLLAMA_MODEL=llama3.2

# Required only if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — enables additional trend sources
# Reddit (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Twitter/X — requires Basic tier ($100/mo) for trends
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# YouTube Data API v3 (https://console.cloud.google.com)
YOUTUBE_API_KEY=your_youtube_api_key

# Facebook Graph API (requires user access token with pages_read_engagement)
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
